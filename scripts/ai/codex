#!/usr/bin/env python3
"""Launch Codex using native project configuration; never rewrite global settings."""

import json
import os
from pathlib import Path
import selectors
import shutil
import subprocess
import sys
import time
import tomllib

ROOT = Path(__file__).resolve().parents[2]
SKILLS = ("ipam-contract", "aws-reconciliation", "terraform-provider",
          "compose-development", "helm-validation")
DIAGNOSTICS = {"--check-config", "--check-skills", "--print-config"}


class InspectionError(Exception):
    """A deliberately secret-free diagnostic message."""


def native_read(executable, method, params):
    """Read a fresh app-server without config overrides or model turns.

    Never forward raw RPC errors or stderr: inherited configuration can contain
    credentials in commands, environments, headers, and URLs.
    """
    process = subprocess.Popen(
        [executable, "-C", str(ROOT), "app-server"], cwd=ROOT,
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )
    buffer = b""
    deadline = time.monotonic() + 30
    selector = selectors.DefaultSelector()
    selector.register(process.stdout, selectors.EVENT_READ)

    def send(message):
        process.stdin.write((json.dumps(message) + "\n").encode())
        process.stdin.flush()

    def request(identifier, method, params):
        nonlocal buffer
        send({"id": identifier, "method": method, "params": params})
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise InspectionError("Native Codex inspection timed out.")
            if b"\n" not in buffer:
                if not selector.select(remaining):
                    raise InspectionError("Native Codex inspection timed out.")
                chunk = os.read(process.stdout.fileno(), 65536)
                if not chunk:
                    raise InspectionError("Native Codex inspection stopped; check config validity and access to the Codex state directory.")
                buffer += chunk
                continue
            line, buffer = buffer.split(b"\n", 1)
            response = json.loads(line)
            if response.get("id") == identifier:
                if "error" in response:
                    raise InspectionError("Native Codex rejected the inspection request.")
                return response["result"]

    try:
        request(1, "initialize", {
            "clientInfo": {"name": "platform-ipam-tooling", "version": "1.0"},
            "capabilities": {},
        })
        send({"method": "initialized"})
        return request(2, method, params)
    finally:
        selector.close()
        process.terminate()
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()
        process.stdin.close()
        process.stdout.close()


def matches(expected, actual):
    """Compare project declarations while allowing additional inherited fields."""
    if isinstance(expected, dict):
        return isinstance(actual, dict) and all(
            key in actual and matches(value, actual[key]) for key, value in expected.items()
        )
    return expected == actual


def check_config(executable, config):
    result = native_read(executable, "config/read", {"cwd": str(ROOT), "includeLayers": True})
    project_layers = [layer for layer in result["layers"] or []
                      if layer["name"].get("type") == "project"
                      and layer["name"].get("dotCodexFolder") == str(ROOT / ".codex")]
    loaded = any(not layer.get("disabledReason") and matches(config, layer["config"])
                 for layer in project_layers)
    effective = result["config"].get("mcp_servers", {})
    mismatches = [name for name, settings in config["mcp_servers"].items()
                  if not matches(settings, effective.get(name))]
    # Also exercise Codex's MCP parser: inherited-only entries need a real
    # transport, and raw config/read alone does not prove that validity.
    parsed = subprocess.run(
        [executable, "-C", str(ROOT), "mcp", "list", "--json"], cwd=ROOT,
        capture_output=True, text=True, timeout=30,
    )
    if parsed.returncode:
        raise InspectionError("Native Codex could not load MCP registrations; check configuration and inherited transports.")
    servers = {item["name"]: item.get("enabled", True) for item in json.loads(parsed.stdout)}
    mismatches += [name for name, settings in config["mcp_servers"].items()
                   if servers.get(name) != settings.get("enabled", True)]
    passed = loaded and not mismatches
    print(json.dumps({
        "status": "PASSED" if passed else "FAILED",
        "scope": "native project configuration loading only; no connectivity test",
        "project_layer_loaded": loaded, "servers": servers,
        "mismatches": sorted(set(mismatches)),
    }))
    return 0 if passed else 1


def check_skills(executable):
    result = native_read(executable, "skills/list", {"cwds": [str(ROOT)], "forceReload": True})
    entries = [entry for entry in result["data"] if entry["cwd"] == str(ROOT)]
    discovered = [skill for entry in entries for skill in entry["skills"]]
    statuses = {}
    for name in SKILLS:
        candidates = [skill for skill in discovered if skill["name"] == name]
        statuses[name] = len(candidates) == 1 and all(
            skill["scope"] == "repo" and skill["enabled"]
            and skill["path"] == str(ROOT / ".agents/skills" / name / "SKILL.md")
            for skill in candidates
        )
    errors = sum(len(entry.get("errors", [])) for entry in entries)
    passed = all(statuses.values()) and not errors
    print(json.dumps({
        "status": "PASSED" if passed else "FAILED",
        "scope": "fresh Codex skill discovery only; no model turn or MCP connectivity test",
        "skills": statuses, "discovery_error_count": errors,
    }))
    return 0 if passed else 1


def main():
    arguments = sys.argv[1:]
    diagnostics = DIAGNOSTICS.intersection(arguments)
    if diagnostics and (len(arguments) != 1 or len(diagnostics) != 1):
        raise InspectionError("Run each diagnostic alone; command-line overrides are excluded from native verification.")
    path = ROOT / ".codex/config.toml"
    if not path.is_file():
        raise InspectionError("Missing native project configuration: .codex/config.toml.")
    config = tomllib.loads(path.read_text())
    if not isinstance(config.get("mcp_servers"), dict) or not config["mcp_servers"]:
        raise InspectionError("Native project configuration must declare its MCP settings.")
    if arguments == ["--print-config"]:
        # A full project config may contain secrets or unrelated settings.
        # Even command arguments and endpoint URLs are omitted from diagnostics.
        print(json.dumps({"source": ".codex/config.toml", "mcp_servers": {
            name: {"enabled": settings.get("enabled", True),
                   "transport": "project" if "url" in settings or "command" in settings else "inherited"}
            for name, settings in config["mcp_servers"].items()
        }}, indent=2))
        return 0
    executable = shutil.which("codex")
    if not executable or Path(executable).resolve() == Path(__file__).resolve():
        raise InspectionError("Codex CLI is missing from PATH or resolves to this launcher.")
    if arguments == ["--check-config"]:
        return check_config(executable, config)
    if arguments == ["--check-skills"]:
        return check_skills(executable)
    # Preserve caller argv literally; Codex applies explicit one-off overrides.
    os.execv(executable, [executable, "-C", str(ROOT), *arguments])


def run():
    try:
        return main()
    except InspectionError as error:
        reason = str(error)
    except (OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired):
        # Exception text can contain inherited secrets (including invalid TOML).
        reason = "Native inspection unavailable; check config syntax, Codex version, and state-directory access."
    print(json.dumps({"status": "BLOCKED", "reason": reason}), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(run())
