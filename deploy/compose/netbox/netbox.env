# Development-only NetBox environment, based on netbox-docker 5.0.2.
API_TOKEN_PEPPER_1=local-api-token-pepper-0123456789abcdef0123456789abcdef
DB_HOST=netbox-db
DB_NAME=netbox
DB_PASSWORD=netbox_dev_password
DB_USER=netbox
EMAIL_FROM=netbox@localhost
EMAIL_PORT=25
EMAIL_SERVER=localhost
GRAPHQL_ENABLED=true
MEDIA_ROOT=/opt/netbox/netbox/media
# ui-proxy (package A3, docs/GUI_AUTHENTICATION.md section 2) authenticates
# with bcrypt and tells NetBox who logged in through this header, deleting
# any client-supplied copy first. REMOTE_AUTH_BACKEND is left unset: its
# image default, netbox.authentication.RemoteUserBackend, is exactly what
# `basic` mode needs (docs/GUI_AUTHENTICATION.md "Verified in image" table).
# REMOTE_AUTH_AUTO_CREATE_GROUPS and every *_SUPERUSER_*/*_STAFF_* setting
# stay unset: groups come from deploy/compose/netbox/bootstrap-groups.py, not
# from a header, and no header may grant elevated NetBox access.
REMOTE_AUTH_ENABLED=true
REMOTE_AUTH_HEADER=HTTP_X_REMOTE_USER
REMOTE_AUTH_AUTO_CREATE_USER=true
REMOTE_AUTH_DEFAULT_GROUPS=platform-operators
REDIS_CACHE_DATABASE=1
REDIS_CACHE_HOST=netbox-redis-cache
REDIS_CACHE_PASSWORD=netbox_cache_dev_password
REDIS_CACHE_SSL=false
REDIS_DATABASE=0
REDIS_HOST=netbox-redis
REDIS_PASSWORD=netbox_redis_dev_password
REDIS_SSL=false
SECRET_KEY=local-development-secret-key-change-me-0123456789abcdef0123456789abcdef
SKIP_SUPERUSER=true
WEBHOOKS_ENABLED=true
