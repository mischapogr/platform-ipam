# Copy this file to .env (or run ./create-env.sh). Values are development-only.
COMPOSE_PROJECT_NAME=platform-ipam-dev
PLATFORM_DB_USER=platform_ipam
PLATFORM_DB_PASSWORD=platform_ipam_dev_password
PLATFORM_DB_NAME=platform_ipam
IPAM_ENVIRONMENT=development
IPAM_AUTH_MODE=local
IPAM_LOCAL_TOKEN=local-development-token-123456
IPAM_LOCAL_SUBJECT=developer
# Second local development identity (package G3c, deploy/compose/README.md):
# tenant "ops", eligible for no pool. Honoured only in local auth mode.
IPAM_OPS_TOKEN=local-ops-development-token-123456
# The operator identity (package G3b1, deploy/compose/README.md): role
# operator, no tenant. Generated and honoured the same way as IPAM_OPS_TOKEN
# above.
IPAM_OPERATOR_TOKEN=local-operator-development-token-123456
IPAM_AWS_MODE=fake
IPAM_LISTEN_ADDR=:8080
IPAM_CONFIG_FILE=/etc/platform-ipam/config/pools.yaml
# The NetBox overlay uses http://netbox:8080 internally. This remains useful
# when only compose.yaml is started against an external development NetBox.
IPAM_NETBOX_URL=http://netbox:8080
IPAM_NETBOX_TOKEN=local-netbox-development-token-000000000
IPAM_OIDC_ISSUER=
IPAM_OIDC_AUDIENCE=
IPAM_IDENTITY_FILE=/etc/platform-ipam/identity/identities.yaml
NETBOX_DB_PASSWORD=netbox_dev_password
NETBOX_REDIS_PASSWORD=netbox_redis_dev_password
NETBOX_CACHE_PASSWORD=netbox_cache_dev_password
NETBOX_SECRET_KEY=local-development-secret-key-change-me-0123456789abcdef0123456789abcdef
NETBOX_API_TOKEN_PEPPER=local-development-api-token-pepper-0123456789abcdef0123456789abcdef
NETBOX_PORT=18000
NETBOX_SUPERUSER_PASSWORD=local-netbox-superuser-development-password
# Host port the API is published on (loopback only). Change it when another
# project on this machine already holds 8080; nothing inside the stack uses it.
IPAM_API_PORT=8080
# Read-only viewer token for tests/e2e/test_e2e_netbox_roles.py (package A2).
# Same 40-character v1-token constraint as IPAM_NETBOX_TOKEN above.
NETBOX_E2E_VIEWER_TOKEN=local-e2e-viewer-development-token-00000
# Write-enabled v1 token for the inventory maintainer REST permission test.
NETBOX_E2E_MAINTAINER_TOKEN=local-e2e-maintainer-development-token-0
# ui-proxy basic-auth credential (package A3, docs/GUI_AUTHENTICATION.md) --
# the only published path to the NetBox UI. Only the plaintext is stored
# here; deploy/compose/ui-proxy/entrypoint.sh hashes it with bcrypt at
# container start.
NETBOX_UI_USER=operator
NETBOX_UI_PASSWORD=local-ui-proxy-development-password
# Set to 1 only while diagnosing NetBox startup; it prints the underlying
# database readiness exception into the NetBox container log.
NETBOX_DB_WAIT_DEBUG=0
